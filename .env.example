# LoopForge local configuration template.
# Copy to .env only when backend/auth features are required.
# Never commit real credentials.

# Optional app/backend endpoint
EXPO_PUBLIC_API_BASE_URL=

# Optional OAuth integration
EXPO_PUBLIC_APP_ID=
EXPO_PUBLIC_OAUTH_PORTAL_URL=
EXPO_PUBLIC_OAUTH_SERVER_URL=
EXPO_PUBLIC_OWNER_OPEN_ID=
EXPO_PUBLIC_OWNER_NAME=

# Optional server-side configuration
DATABASE_URL=
JWT_SECRET=
OAUTH_SERVER_URL=
OWNER_OPEN_ID=
OWNER_NAME=

# Optional external service integrations
BUILT_IN_FORGE_API_URL=
BUILT_IN_FORGE_API_KEY=

# Stable native deep-link scheme (must match app.config.ts)
EXPO_PUBLIC_DEEP_LINK_SCHEME=loopforge
